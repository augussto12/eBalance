# Copiar a .env y completar. SOLO configuración pública y rutas: NINGÚN secreto acá.
COMPOSE_PROJECT_NAME=alvarez-finanzas
# Origen público exacto (https, sin barra final). Se valida contra Origin/Referer.
PUBLIC_ORIGIN=https://finanzas.TU-DOMINIO
# Tag inmutable de imágenes (deploy.sh usa el commit de Git).
IMAGE_TAG=local
# Publicación del contenedor web: SIEMPRE loopback; el Nginx del host termina TLS.
WEB_BIND=127.0.0.1:8088
# Directorio de secretos (fuera del repo en producción), permisos 700.
SECRETS_DIR=/srv/alvarez-finanzas/secrets
# Repositorio local de backups cifrados (restic). Además, configurá una copia FUERA de la VPS (ver RUNBOOK).
BACKUP_DIR=/srv/alvarez-finanzas/backups
RESTIC_REPOSITORY=/backups/restic
